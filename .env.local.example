# ==========================================
# YT CREW - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local and fill in the actual values.
# NEVER commit .env.local or real secret keys to version control!
# ==========================================

# ------------------------------------------
# SUPABASE (Database & Authentication)
# ------------------------------------------
# Public URL for your Supabase project (safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous API key for client-side Supabase operations (protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Secret service role key for administrative/server-side operations (bypasses RLS)
# CRITICAL: NEVER expose this on the client or prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------
# YOUTUBE DATA API V3 (Phase C Tools)
# ------------------------------------------
# Google Cloud Console YouTube Data API v3 key (server-side only)
# Restrict this key with HTTP referrer/IP restrictions in Google Cloud Console
YOUTUBE_API_KEY=your-google-youtube-api-key-here

# ------------------------------------------
# AI PROVIDERS (Phase B Tools)
# ------------------------------------------
# OpenAI API Key for AI text/title/description generation tools
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Claude API Key (optional / alternative AI engine)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ------------------------------------------
# UPSTASH REDIS (Caching & Rate Limiting)
# ------------------------------------------
# Required for caching YouTube API responses and rate limiting AI endpoints
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token-here

# ------------------------------------------
# APPLICATION CONFIG
# ------------------------------------------
# Base URL for public site (used for sitemap, robots.txt, metadata, and canonical links)
# Local: http://localhost:3000 | Production: https://ytcrew.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------
# ANALYTICS (GA4)
# ------------------------------------------
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX


